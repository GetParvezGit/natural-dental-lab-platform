@page "/case-types/new"
@page "/case-types/{CaseTypeId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,Admin")]
@using System.ComponentModel.DataAnnotations
@using DentalLab.Application.Abstractions
@using DentalLab.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICaseTypeService Service
@inject NavigationManager Nav
<PageTitle>@(IsNew ? "Add Case Type" : "Edit Case Type")</PageTitle>
<div class="case-type-form-page">
<section class="form-hero"><div><span class="eyebrow">Production configuration</span><h1>@(IsNew ? "Add Case Type" : "Edit Case Type")</h1><p>Configure the product code, production scope, order, and availability.</p></div><a class="btn back-button" href="/case-types">Back to case types</a></section>
@if(model is null){<div class="loading-state">Loading...</div>}else{
<EditForm Model="model" OnValidSubmit="Save" FormName="caseTypeForm"><DataAnnotationsValidator/>
<section class="form-card"><header class="form-card-header"><div><span>CASE TYPE PROFILE</span><h2>Case type details</h2></div>@if(!IsNew){<span class="id-chip">Case Type #@CaseTypeId</span>}</header>
<div class="form-card-body"><div class="form-grid">
<div><label class="form-label">Code</label><InputText class="form-control text-uppercase" @bind-Value="model.Code" placeholder="Enter case type code"/><ValidationMessage For="()=>model.Code"/></div>
<div><label class="form-label">Name</label><InputText class="form-control" @bind-Value="model.Name" placeholder="Enter case type name"/><ValidationMessage For="()=>model.Name"/></div>
<div><label class="form-label">Scope</label><InputSelect class="form-select" @bind-Value="model.Scope"><option value="T">Per tooth</option><option value="A">Whole arch</option></InputSelect></div>
<div><label class="form-label">Display order</label><InputNumber class="form-control" @bind-Value="model.Order"/><ValidationMessage For="()=>model.Order"/></div>
@if(!IsNew){<div class="status-field"><div><strong>Availability</strong><span>Active case types can be used in production.</span></div><label><InputCheckbox class="form-check-input" id="active" @bind-Value="model.Active"/><span>Active</span></label></div>}
</div>@if(error is not null){<div class="alert alert-danger">@error</div>}</div>
<footer class="form-actions"><a class="btn btn-outline-secondary" href="/case-types">Cancel</a><button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Saving..." : IsNew ? "Add case type" : "Save changes")</button></footer>
</section></EditForm>}
</div>
@code{[Parameter]public int? CaseTypeId{get;set;}private bool IsNew=>CaseTypeId is null;private Form? model;private bool saving;private string? error;protected override async Task OnParametersSetAsync(){if(IsNew){model=new(){Order=await Service.GetNextDisplayOrderAsync()};return;}var x=await Service.GetByIdAsync(CaseTypeId!.Value);if(x is null){Nav.NavigateTo("/case-types");return;}model=new(){Code=x.CaseTypeCode,Name=x.CaseTypeName,Scope=x.Scope,Order=x.DisplayOrder,Active=x.IsActive};}private async Task Save(){saving=true;error=null;try{var x=new CaseType{CaseTypeId=CaseTypeId??0,CaseTypeCode=model!.Code,CaseTypeName=model.Name,Scope=model.Scope,DisplayOrder=model.Order,IsActive=model.Active};if(IsNew)await Service.CreateAsync(x);else await Service.UpdateAsync(x);Nav.NavigateTo("/case-types");}catch(DbUpdateException){error="Code or name already exists, or scope is already used by records.";}finally{saving=false;}}private sealed class Form{[Required,StringLength(20),RegularExpression("^[A-Za-z0-9 _-]+$")]public string Code{get;set;}="";[Required,StringLength(100)]public string Name{get;set;}="";public char Scope{get;set;}='T';[Range(1,32767)]public short Order{get;set;}=100;public bool Active{get;set;}=true;}}
