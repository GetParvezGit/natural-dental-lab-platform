@page "/contact"

<PageTitle>Contact - Natural Dental Lab</PageTitle>

<div class="contact-page">
    <section class="contact-intro">
        <span class="eyebrow">Contact</span>
        <h1>Natural Dental Lab</h1>
        <p>
            For authorized laboratory support, account access, doctor case
            coordination, or billing assistance, contact the Natural Dental
            Lab team using the organization-approved details below.
        </p>
    </section>

    <section class="contact-grid">
        <article>
            <span class="contact-label">Email</span>
            <strong>Configure business email</strong>
            <p>Replace this placeholder with the approved Natural Dental Lab contact address.</p>
        </article>
        <article>
            <span class="contact-label">Phone</span>
            <strong>Configure business phone</strong>
            <p>Publish only the laboratory's approved business contact number.</p>
        </article>
        <article>
            <span class="contact-label">Address</span>
            <strong>Configure laboratory address</strong>
            <p>Add the approved business address before publishing the repository or site.</p>
        </article>
    </section>

    <section class="support-note">
        <div>
            <span class="eyebrow">Account support</span>
            <h2>Existing users can recover access securely.</h2>
            <p>Use Forgot Password for account recovery. Never send passwords through chat or support tickets.</p>
        </div>
        <a href="/Account/ForgotPassword">Forgot password</a>
    </section>
</div>
