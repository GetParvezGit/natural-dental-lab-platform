@page "/cases"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,Admin,Staff")]

@using DentalLab.Application.Abstractions
@using DentalLab.Application.Models.Cases
@using DentalLab.Application.Models.Common
@using DentalLab.Domain.Entities
@using DentalLab.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization

@inject ICaseService CaseService
@inject IDoctorService DoctorService

<PageTitle>Cases</PageTitle>

<div class="cases-page">
    <div class="cases-heading">
        <div>
            <h3 class="mb-0">Cases</h3>
            <small class="text-muted">Search and review dental-lab cases.</small>
        </div>

        <a class="btn btn-primary btn-sm new-case-button" href="/cases/new">
            New case
        </a>
    </div>

    <div class="card filter-card">
        <div class="card-body">
            <div class="case-filters">
                <div class="filter-field filter-case-id">
                    <label class="form-label">Case ID</label>
                    <InputNumber class="form-control form-control-sm" @bind-Value="filter.CaseId" placeholder="Enter CaseID" />
                </div>

                <div class="filter-field filter-doctor">
                    <label class="form-label">Doctor</label>
                    <InputSelect class="form-select form-select-sm" @bind-Value="filter.DocId">
                        <option value="">All Doctors</option>
                        @foreach (var doctor in doctors)
                        {
                            <option value="@doctor.DocId">@doctor.DocName</option>
                        }
                    </InputSelect>
                </div>

                <div class="filter-field filter-patient">
                    <label class="form-label">Patient / Reference</label>
                    <InputText class="form-control form-control-sm" @bind-Value="filter.Patient" placeholder="PatientName or Reference" />
                </div>

                <div class="filter-field filter-date">
                    <label class="form-label">From</label>
                    <InputDate class="form-control form-control-sm date-input" @bind-Value="filter.FromDate" placeholder="Start date" title="Start date" />
                </div>

                <div class="filter-field filter-date">
                    <label class="form-label">To</label>
                    <InputDate class="form-control form-control-sm date-input" @bind-Value="filter.ToDate" placeholder="End date" title="End date" />
                </div>

                <div class="filter-field filter-status">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select form-select-sm" @bind-Value="filter.Status">
                        <option value="All">All</option>
                        <option value="Active">Active</option>
                        <option value="Cancelled">Cancelled</option>
                    </InputSelect>
                </div>

                <div class="filter-actions">
                    <button type="button" class="btn btn-primary btn-sm" disabled="@loading" @onclick="SearchAsync">Search</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@loading" @onclick="ResetAsync">Reset</button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-4">
            <div class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></div>
            <span class="ms-2">Loading Cases...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (result is null || result.Items.Count == 0)
    {
        <div class="alert alert-info">No cases found.</div>
    }
    else
    {
        <div class="table-responsive cases-table-container">
            <table class="table table-sm table-bordered table-hover align-middle case-table">
                <thead>
                    <tr>
                        <th><button type="button" class="sort-header" @onclick="() => SortBy(CaseSortColumn.CaseId)">Case ID <span class="sort-indicator">@SortIndicator(CaseSortColumn.CaseId)</span></button></th>
                        <th><button type="button" class="sort-header" @onclick="() => SortBy(CaseSortColumn.Date)">Date <span class="sort-indicator">@SortIndicator(CaseSortColumn.Date)</span></button></th>
                        <th><button type="button" class="sort-header" @onclick="() => SortBy(CaseSortColumn.Doctor)">Doctor <span class="sort-indicator">@SortIndicator(CaseSortColumn.Doctor)</span></button></th>
                        <th>Patient</th>
                        <th>Teeth / Arch</th>
                        <th>Type</th>
                        <th class="text-end">Unit Rate</th>
                        <th class="text-end">Units</th>
                        <th class="text-end">Unit Amount</th>
                        <th class="text-end"><button type="button" class="sort-header sort-header-end" @onclick="() => SortBy(CaseSortColumn.TotalAmount)">Total Amount <span class="sort-indicator">@SortIndicator(CaseSortColumn.TotalAmount)</span></button></th>
                        <th>Status</th>
                        <th class="text-center">View</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var visibleItems = SortedItems.ToList();
                    }
                    @for (var caseIndex = 0; caseIndex < visibleItems.Count; caseIndex++)
                    {
                        var item = visibleItems[caseIndex];
                        var rowSpan = Math.Max(item.Lines.Count, 1);
                        var caseGroupClass = caseIndex % 2 == 0
                            ? "case-group-light"
                            : "case-group-shaded";

                        @for (var index = 0; index < item.Lines.Count; index++)
                        {
                            var line = item.Lines[index];
                            <tr class="@GetCaseRowClass(caseGroupClass, item.IsCancelled, item.CaseId)"
                                @onmouseenter="() => hoveredCaseId = item.CaseId"
                                @onmouseleave="() => hoveredCaseId = null">
                                @if (index == 0)
                                {
                                    <td rowspan="@rowSpan" class="case-id-cell">#@item.CaseId</td>
                                    <td rowspan="@rowSpan" class="text-nowrap">@item.CaseDate.ToString("dd/MM/yyyy")</td>
                                    <td rowspan="@rowSpan">@item.DoctorName</td>
                                    <td rowspan="@rowSpan">
                                        <div class="patient-cell">
                                            <span>@DisplayValue(item.PatientName)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.PatientRef))
                                            {
                                                <small class="text-muted">@item.PatientRef</small>
                                            }
                                        </div>
                                    </td>
                                }

                                <td class="teeth-cell">
                                    <CompactToothGrid Scope="@line.Scope" Arch="@line.Arch" UR="@line.UR" UL="@line.UL" LR="@line.LR" LL="@line.LL" />
                                </td>
                                <td><span class="@Badge(line.CaseTypeCode)">@line.CaseTypeCode</span></td>
                                <td class="text-end text-nowrap">@line.UnitRate.ToString("N2")</td>
                                <td class="text-end">@line.Units</td>
                                <td class="text-end text-nowrap">@line.Amount.ToString("N2")</td>

                                @if (index == 0)
                                {
                                    <td rowspan="@rowSpan" class="text-end text-nowrap total-amount-cell">@item.TotalAmount.ToString("N2")</td>
                                    <td rowspan="@rowSpan" class="status-cell">
                                        @if (item.IsCancelled)
                                        {
                                            <span class="badge text-bg-secondary">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">Active</span>
                                        }
                                    </td>
                                    <td rowspan="@rowSpan" class="text-center view-cell">
                                        <a class="btn btn-sm btn-outline-primary view-button" href="@($"/cases/{item.CaseId}")">View</a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-bar">
            <span>
                Page @result.PageNumber of @result.TotalPages
                <span class="text-muted">(@result.TotalCount total)</span>
            </span>
            <div class="d-flex align-items-center gap-2">
                <label class="text-muted">Rows</label>
                <select class="form-select form-select-sm page-size" value="@filter.PageSize" @onchange="SizeChangedAsync">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!result.HasPreviousPage || loading)" @onclick="PreviousAsync">Previous</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!result.HasNextPage || loading)" @onclick="NextAsync">Next</button>
            </div>
        </div>
    }
</div>

@code {
    private readonly CaseFilter filter = new();
    private List<Doctor> doctors = [];
    private PagedResult<CaseListItem>? result;
    private bool loading;
    private int? hoveredCaseId;
    private CaseSortColumn sortColumn = CaseSortColumn.Date;
    private bool sortDescending = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        filter.Status = "All";
        doctors = await DoctorService.GetAllAsync();
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        filter.PageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try { result = await CaseService.SearchAsync(filter); }
        catch (Exception) { error = "Cases could not be loaded. Please try again."; }
        finally { loading = false; }
    }

    private async Task ResetAsync()
    {
        filter.CaseId = null;
        filter.DocId = null;
        filter.Patient = null;
        filter.FromDate = null;
        filter.ToDate = null;
        filter.Status = "All";
        filter.PageNumber = 1;
        await LoadAsync();
    }

    private IEnumerable<CaseListItem> SortedItems
    {
        get
        {
            if (result is null)
            {
                return [];
            }

            return (sortColumn, sortDescending) switch
            {
                (CaseSortColumn.CaseId, false) => result.Items.OrderBy(item => item.CaseId),
                (CaseSortColumn.CaseId, true) => result.Items.OrderByDescending(item => item.CaseId),
                (CaseSortColumn.Date, false) => result.Items.OrderBy(item => item.CaseDate),
                (CaseSortColumn.Date, true) => result.Items.OrderByDescending(item => item.CaseDate),
                (CaseSortColumn.Doctor, false) => result.Items.OrderBy(item => item.DoctorName),
                (CaseSortColumn.Doctor, true) => result.Items.OrderByDescending(item => item.DoctorName),
                (CaseSortColumn.TotalAmount, false) => result.Items.OrderBy(item => item.TotalAmount),
                _ => result.Items.OrderByDescending(item => item.TotalAmount)
            };
        }
    }

    private void SortBy(CaseSortColumn column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
            return;
        }

        sortColumn = column;
        sortDescending = column is CaseSortColumn.CaseId
            or CaseSortColumn.Date
            or CaseSortColumn.TotalAmount;
    }

    private string SortIndicator(CaseSortColumn column)
    {
        if (sortColumn != column)
        {
            return "↕";
        }

        return sortDescending ? "↓" : "↑";
    }

    private string GetCaseRowClass(string groupClass, bool isCancelled, int caseId)
    {
        var classes = new List<string> { groupClass };
        if (isCancelled) classes.Add("cancelled-case");
        if (hoveredCaseId == caseId) classes.Add("case-group-hovered");
        return string.Join(" ", classes);
    }

    private async Task PreviousAsync()
    {
        if (result?.HasPreviousPage != true) return;
        filter.PageNumber--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        if (result?.HasNextPage != true) return;
        filter.PageNumber++;
        await LoadAsync();
    }

    private async Task SizeChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var pageSize)) filter.PageSize = pageSize;
        filter.PageNumber = 1;
        await LoadAsync();
    }

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string Badge(string code)
    {
        var colour = code switch
        {
            "CR" => "text-bg-primary",
            "ZR" => "text-bg-success",
            "DMLS" => "text-bg-info",
            "IMP_DMLS" => "text-bg-warning",
            "DENTURE" => "text-bg-danger",
            "RETAINER" => "text-bg-teal",
            _ => "text-bg-secondary"
        };
        return $"badge case-badge {colour}";
    }
    private enum CaseSortColumn
    {
        CaseId,
        Date,
        Doctor,
        TotalAmount
    }
}
