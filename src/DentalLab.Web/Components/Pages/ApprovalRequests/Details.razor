@page "/approval-requests/{RequestId:long}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,Admin,Staff")]

@using System.Security.Claims
@using DentalLab.Application.Abstractions
@using DentalLab.Application.Models.Approvals
@using DentalLab.Application.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject ICaseApprovalService ApprovalService
@inject NavigationManager Nav

<PageTitle>Approval Request</PageTitle>

<div class="request-details-page">
    @if (loading)
    {
        <div class="request-state">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Loading approval request...</span>
        </div>
    }
    else if (item is null)
    {
        <div class="alert alert-warning">Request not found or access denied.</div>
    }
    else
    {
        <section class="request-hero">
            <div>
                <span class="eyebrow">Workflow request</span>
                <h1>Approval Request #@item.RequestId</h1>
                <div class="hero-meta">
                    <span class="status-pill @StatusClass(item.Status)">@item.Status</span>
                    <span>Case #@item.CaseId</span>
                    <span>@item.RequestType request</span>
                </div>
            </div>
            <div class="hero-actions">
                <a class="btn hero-button" href="/approval-requests">Back</a>
                <a class="btn hero-button hero-button-primary" href="@($"/cases/{item.CaseId}")">View Case</a>
            </div>
        </section>

        @if (item.Status == CaseApprovalRequestStatuses.Approved)
        {
            <div class="workflow-alert">
                <span class="workflow-alert-icon">!</span>
                <div>
                    <strong>Approved, action pending</strong>
                    <p>This request remains active and blocks new requests for Case #@item.CaseId until the approved action is completed.</p>
                </div>
            </div>
        }

        <section class="request-card">
            <header class="request-card-header">
                <div>
                    <span class="section-kicker">Request overview</span>
                    <h2>Request information</h2>
                </div>
                <span class="request-number">#@item.RequestId</span>
            </header>

            <div class="request-card-body">
                <div class="summary-grid">
                    <div class="summary-item">
                        <span>Case</span>
                        <strong>#@item.CaseId</strong>
                    </div>
                    <div class="summary-item">
                        <span>Request Type</span>
                        <strong>@item.RequestType</strong>
                    </div>
                    <div class="summary-item summary-email">
                        <span>Requested By</span>
                        <strong title="@item.RequestedByEmail">@item.RequestedByEmail</strong>
                    </div>
                    <div class="summary-item summary-email">
                        <span>Assigned Admin</span>
                        <strong title="@item.AssignedAdminEmail">@item.AssignedAdminEmail</strong>
                    </div>
                </div>

                <div class="narrative-grid">
                    <article class="narrative-card reason-card">
                        <span>Reason</span>
                        <p>@item.Reason</p>
                    </article>

                    @if (!string.IsNullOrWhiteSpace(item.AdditionalDetails))
                    {
                        <article class="narrative-card">
                            <span>Additional Details</span>
                            <p>@item.AdditionalDetails</p>
                        </article>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.ReviewComment))
                    {
                        <article class="narrative-card review-card">
                            <span>Review Decision</span>
                            <p>@item.ReviewComment</p>
                        </article>
                    }
                </div>
            </div>
        </section>

        @if (CanReview && item.Status == CaseApprovalRequestStatuses.Pending)
        {
            <EditForm Model="review" FormName="reviewApprovalForm">
                <DataAnnotationsValidator />
                <section class="request-card review-form-card">
                    <header class="request-card-header">
                        <div>
                            <span class="section-kicker">Admin review</span>
                            <h2>Review request</h2>
                        </div>
                    </header>
                    <div class="request-card-body">
                        <label class="form-label">Review comment</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="review.Comment" placeholder="Enter the reason for the decision" />
                        <ValidationMessage For="() => review.Comment" />
                        @if (!string.IsNullOrWhiteSpace(error))
                        {
                            <div class="alert alert-danger mt-3">@error</div>
                        }
                    </div>
                    <footer class="review-actions">
                        @if (item.RequestType == CaseApprovalRequestTypes.Edit)
                        {
                            <button type="button" class="btn btn-primary" disabled="@saving" @onclick="ApproveEditAsync">Approve &amp; Edit</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled="@saving" @onclick="ApproveCancelAsync">Approve Cancellation</button>
                        }
                        <button type="button" class="btn btn-outline-danger" disabled="@saving" @onclick="RejectAsync">Reject</button>
                    </footer>
                </section>
            </EditForm>
        }
        else if (CanReview && item.Status == CaseApprovalRequestStatuses.Approved)
        {
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger">@error</div>
            }
            <div class="pending-action-card">
                <div>
                    <strong>Complete approved action</strong>
                    <span>Finish the approved workflow to close this request.</span>
                </div>
                @if (item.RequestType == CaseApprovalRequestTypes.Edit)
                {
                    <a class="btn btn-primary" href="@($"/cases/{item.CaseId}/edit?requestId={item.RequestId}")">Continue Approved Edit</a>
                }
                else
                {
                    <button type="button" class="btn btn-danger" disabled="@saving" @onclick="ResumeCancellationAsync">Retry Approved Cancellation</button>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public long RequestId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;
    private CaseApprovalDetails? item; private readonly ReviewCaseApprovalRequest review = new();
    private string currentUserId = string.Empty, currentEmail = string.Empty; private bool isOwner, loading = true, saving; private string? error;
    private bool CanReview => item is not null && (isOwner || item.AssignedAdminUserId == currentUserId);

    protected override async Task OnParametersSetAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var state = await AuthenticationStateTask;
        currentUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        currentEmail = state.User.FindFirstValue(ClaimTypes.Email) ?? state.User.Identity?.Name ?? string.Empty;
        isOwner = state.User.IsInRole(ApplicationRoles.Owner);
        item = await ApprovalService.GetByIdAsync(RequestId, currentUserId, isOwner); loading = false;
    }
    private async Task ApproveEditAsync()
    {
        if (!ValidateComment()) return; saving = true;
        var result = await ApprovalService.ApproveAsync(RequestId, review.Comment, item!.RowVersion, currentUserId, currentEmail, isOwner); saving = false;
        if (!result.Succeeded) { error = result.ErrorMessage; return; }
        Nav.NavigateTo($"/cases/{item.CaseId}/edit?requestId={RequestId}");
    }
    private async Task ApproveCancelAsync()
    {
        if (!ValidateComment()) return; saving = true;
        var result = await ApprovalService.ApproveAndCancelAsync(RequestId, review.Comment, item!.RowVersion, currentUserId, currentEmail, isOwner); saving = false;
        if (!result.Succeeded) { error = result.ErrorMessage; await LoadAsync(); return; }
        Nav.NavigateTo($"/approval-requests/{RequestId}", forceLoad: true);
    }
    private async Task ResumeCancellationAsync()
    {
        saving = true; error = null;
        var result = await ApprovalService.ResumeCancellationAsync(RequestId, currentUserId, currentEmail, isOwner); saving = false;
        if (!result.Succeeded) { error = result.ErrorMessage; return; }
        Nav.NavigateTo($"/approval-requests/{RequestId}", forceLoad: true);
    }
    private async Task RejectAsync()
    {
        if (!ValidateComment()) return; saving = true;
        var result = await ApprovalService.RejectAsync(RequestId, review.Comment, item!.RowVersion, currentUserId, currentEmail, isOwner); saving = false;
        if (!result.Succeeded) { error = result.ErrorMessage; return; }
        Nav.NavigateTo($"/approval-requests/{RequestId}", forceLoad: true);
    }
    private bool ValidateComment() { error = string.IsNullOrWhiteSpace(review.Comment) ? "Review comment is required." : null; return error is null; }
    private static string StatusClass(string status) => status switch { "Pending" => "text-bg-warning", "Approved" => "text-bg-primary", "Completed" => "text-bg-success", "Rejected" => "text-bg-danger", _ => "text-bg-secondary" };
}
