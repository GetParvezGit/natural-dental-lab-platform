@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,Admin")]

@using System.Security.Claims
@using DentalLab.Application.Abstractions
@using DentalLab.Application.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject IUserManagementService UserManagementService

<PageTitle>User Management</PageTitle>

<div class="users-page">
    <section class="users-hero">
        <div>
            <span class="eyebrow">Access administration</span>
            <h1>User Management</h1>
            <p>Create and manage application users according to your role.</p>
        </div>
        <div class="hero-summary">
            <strong>@users.Count</strong>
            <span>manageable users</span>
        </div>
    </section>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(pageError))
{
    <div class="alert alert-danger">@pageError</div>
}
else
{
    <section class="users-toolbar">
        <div class="toolbar-copy">
            <strong>User directory</strong>
            <span>Search, filter, and manage application users</span>
        </div>
        <div class="toolbar-controls">
            <input class="form-control form-control-sm search-input"
                   placeholder="Search user email"
                   value="@searchText"
                   @oninput="SearchChanged" />
            <select class="form-select form-select-sm role-filter"
                    value="@roleFilter"
                    @onchange="RoleFilterChanged">
                <option value="All">All roles</option>
                @foreach (var role in AvailableRoles)
                {
                    <option value="@role">@role</option>
                }
            </select>
            <select class="form-select form-select-sm status-filter"
                    value="@statusFilter"
                    @onchange="StatusFilterChanged">
                <option value="All">All users</option>
                <option value="Active">Active</option>
                <option value="Disabled">Disabled</option>
            </select>
        </div>
    </section>

    <div class="row g-4 users-layout">
        <div class="col-xl-8">
            <div class="card users-table-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Users</span>
                    <span class="badge bg-secondary">@FilteredUsers.Count</span>
                </div>

                <div class="card-body p-0">
                    @if (FilteredUsers.Count == 0)
                    {
                        <div class="alert alert-info m-3">
                            No manageable users were found.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 users-table">
                                <thead>
                                    <tr>
                                        <th>User Email</th>
                                        <th>Role</th>
                                        <th>Email Status</th>
                                        <th>Invitation</th>
                                        <th>Password</th>
                                        <th>Account</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in PagedUsers)
                                    {
                                        <tr class="@(user.IsLocked ? "text-muted" : string.Empty)">
                                            <td>@user.Email</td>
                                            <td>
                                                <span class="badge @RoleBadge(user.Role)">
                                                    @user.Role
                                                </span>
                                            </td>
                                            <td>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <span class="badge bg-success">Confirmed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Unconfirmed</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @InvitationBadge(user.InvitationEmailStatus)"
                                                      title="@user.InvitationEmailError">
                                                    @user.InvitationEmailStatus
                                                </span>
                                                @if (user.InvitationEmailSentOn.HasValue)
                                                {
                                                    <div class="small text-muted text-nowrap">
                                                        @user.InvitationEmailSentOn.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (user.MustChangePassword)
                                                {
                                                    <span class="badge bg-warning text-dark">Temporary</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Changed</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-@(user.IsLocked ? "secondary" : "success")">
                                                    @(user.IsLocked ? "Disabled" : "Active")
                                                </span>
                                            </td>
                                            <td class="text-end text-nowrap actions-cell">
                                                @if (user.MustChangePassword ||
                                                     !string.Equals(user.InvitationEmailStatus, "Sent", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-primary me-1"
                                                            disabled="@isProcessing"
                                                            @onclick="() => ResendInvitationAsync(user)">
                                                        Resend
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="btn btn-sm @(user.IsLocked ? "btn-outline-success" : "btn-outline-secondary")"
                                                        disabled="@isProcessing"
                                                        @onclick="() => ToggleLockoutAsync(user)">
                                                    @(user.IsLocked ? "Enable" : "Disable")
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="users-pagination">
                            <span>Page @PageNumber of @TotalPages <span class="text-muted">(@FilteredUsers.Count total)</span></span>
                            <div class="pagination-controls">
                                <label for="usersPageSize">Rows</label>
                                <select id="usersPageSize" class="form-select form-select-sm page-size" value="@pageSize" @onchange="PageSizeChanged">
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(PageNumber <= 1)" @onclick="PreviousPage">Previous</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(PageNumber >= TotalPages)" @onclick="NextPage">Next</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card create-user-card">
                <div class="card-header">Create user</div>
                <div class="card-body">
                    @if (assignableRoles.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            Your account cannot create users.
                        </div>
                    }
                    else
                    {
                        <EditForm Model="request"
                                  OnValidSubmit="CreateUserAsync"
                                  FormName="createUserForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <InputText class="form-control"
                                           type="email"
                                           autocomplete="off"
                                           @bind-Value="request.Email"
                                           placeholder="Enter user email" />
                                <ValidationMessage For="() => request.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Role</label>
                                <InputSelect class="form-select"
                                             @bind-Value="request.Role">
                                    <option value="">-- select role --</option>
                                    @foreach (var role in assignableRoles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => request.Role" />
                            </div>

                            <div class="alert alert-info py-2">
                                A secure temporary password will be generated automatically and sent to the email address through SMTP.
                            </div>

                            @if (!string.IsNullOrWhiteSpace(formError))
                            {
                                <div class="alert alert-danger">@formError</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(successMessage))
                            {
                                <div class="alert alert-success">@successMessage</div>
                            }

                            <button type="submit"
                                    class="btn btn-primary create-user-button"
                                    disabled="@isProcessing">
                                @(isProcessing ? "Creating..." : "Create user")
                            </button>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private readonly List<UserListItem> users = [];
    private readonly List<string> assignableRoles = [];
    private CreateUserRequest request = new();

    private string currentUserId = string.Empty;
    private string? pageError;
    private string? formError;
    private string? successMessage;
    private bool isLoading = true;
    private bool isProcessing;
    private string searchText = string.Empty;
    private string roleFilter = "All";
    private string statusFilter = "All";
    private int pageNumber = 1;
    private int pageSize = 10;

    private List<string> AvailableRoles => users
        .Select(user => user.Role)
        .Where(role => !string.IsNullOrWhiteSpace(role))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(role => role)
        .ToList();

    private List<UserListItem> FilteredUsers => users
        .Where(user =>
            (string.IsNullOrWhiteSpace(searchText) ||
             user.Email.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)) &&
            (roleFilter == "All" ||
             string.Equals(user.Role, roleFilter, StringComparison.OrdinalIgnoreCase)) &&
            (statusFilter == "All" ||
             (statusFilter == "Active" && !user.IsLocked) ||
             (statusFilter == "Disabled" && user.IsLocked)))
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count / (double)pageSize));

    private int PageNumber
    {
        get => Math.Min(pageNumber, TotalPages);
        set => pageNumber = Math.Clamp(value, 1, TotalPages);
    }

    private List<UserListItem> PagedUsers => FilteredUsers
        .Skip((PageNumber - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateTask;
            currentUserId = authenticationState.User
                .FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            if (string.IsNullOrWhiteSpace(currentUserId))
            {
                pageError = "The current user identifier could not be determined.";
                return;
            }

            await LoadAsync();
        }
        catch (Exception exception)
        {
            pageError = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        var loadedUsers = await UserManagementService.GetUsersAsync(currentUserId);
        var loadedRoles = await UserManagementService.GetAssignableRolesAsync(currentUserId);

        users.Clear();
        users.AddRange(loadedUsers);

        assignableRoles.Clear();
        assignableRoles.AddRange(loadedRoles);
    }

    private async Task CreateUserAsync()
    {
        isProcessing = true;
        formError = null;
        successMessage = null;
        pageError = null;

        try
        {
            var createdEmail = request.Email.Trim();
            var result = await UserManagementService.CreateUserAsync(
                currentUserId,
                request);

            if (!result.Succeeded)
            {
                formError = result.ErrorMessage;
                return;
            }

            successMessage = $"User '{createdEmail}' was created. Check the invitation status in the Users table.";
            request = new CreateUserRequest();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            formError = exception.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ResendInvitationAsync(UserListItem user)
    {
        isProcessing = true;
        pageError = null;
        formError = null;
        successMessage = null;

        try
        {
            var result = await UserManagementService.ResendInvitationAsync(
                currentUserId,
                user.UserId);

            if (!result.Succeeded)
            {
                pageError = result.ErrorMessage;
                return;
            }

            successMessage = $"A new temporary password invitation was generated for '{user.Email}'.";
            await LoadAsync();
        }
        catch (Exception exception)
        {
            pageError = exception.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ToggleLockoutAsync(UserListItem user)
    {
        isProcessing = true;
        formError = null;
        successMessage = null;
        pageError = null;

        try
        {
            var result = await UserManagementService.SetUserLockoutAsync(
                currentUserId,
                user.UserId,
                lockUser: !user.IsLocked);

            if (!result.Succeeded)
            {
                pageError = result.ErrorMessage;
                return;
            }

            successMessage = user.IsLocked
                ? $"User '{user.Email}' was enabled."
                : $"User '{user.Email}' was disabled.";

            await LoadAsync();
        }
        catch (Exception exception)
        {
            pageError = exception.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void SearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        pageNumber = 1;
    }

    private void RoleFilterChanged(ChangeEventArgs args)
    {
        roleFilter = args.Value?.ToString() ?? "All";
        pageNumber = 1;
    }

    private void StatusFilterChanged(ChangeEventArgs args)
    {
        statusFilter = args.Value?.ToString() ?? "All";
        pageNumber = 1;
    }

    private void PreviousPage() => PageNumber--;
    private void NextPage() => PageNumber++;

    private void PageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) pageSize = value;
        pageNumber = 1;
    }

    private static string RoleBadge(string role)
    {
        return role switch
        {
            "Admin" => "bg-primary",
            "Staff" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    private static string InvitationBadge(string status)
    {
        return status switch
        {
            "Sent" => "bg-success",
            "Failed" => "bg-danger",
            "Pending" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}
