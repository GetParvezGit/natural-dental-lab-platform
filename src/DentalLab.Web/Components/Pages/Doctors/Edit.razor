@page "/doctors/new"
@page "/doctors/{DocId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Owner,Admin")]

@using System.ComponentModel.DataAnnotations
@using DentalLab.Application.Abstractions
@using DentalLab.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@inject IDoctorService DoctorService
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Doctor" : "Edit Doctor")</PageTitle>

<div class="doctor-form-page">
    <section class="doctor-form-hero">
        <div>
            <span class="eyebrow">Doctor directory</span>
            <h1>@(IsNew ? "Add Doctor" : "Edit Doctor")</h1>
            <p>@(IsNew
                ? "Create a doctor profile for case entry and rate management."
                : "Update the doctor's contact details and account availability.")</p>
        </div>

    </section>

    @if (model is null)
    {
        <div class="doctor-form-state">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Loading doctor details...</span>
        </div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="Save" FormName="doctorForm">
            <DataAnnotationsValidator />

            <section class="doctor-form-card">
                <header class="form-card-header">
                    <div>
                        <span class="section-kicker">Profile information</span>
                        <h2>Doctor details</h2>
                    </div>
                    @if (!IsNew)
                    {
                        <span class="doctor-id-chip">Doctor #@DocId</span>
                    }
                </header>

                <div class="form-card-body">
                    <div class="form-grid">
                        <div class="field field-name">
                            <label class="form-label">Name</label>
                            <InputText class="form-control"
                                       @bind-Value="model.DocName"
                                       placeholder="Enter doctor name" />
                            <ValidationMessage For="() => model.DocName" />
                        </div>

                        <div class="field">
                            <label class="form-label">Phone</label>
                            <InputText class="form-control"
                                       @bind-Value="model.Phone"
                                       placeholder="Enter phone number" />
                            <ValidationMessage For="() => model.Phone" />
                        </div>

                        <div class="field">
                            <label class="form-label">Email</label>
                            <InputText class="form-control"
                                       @bind-Value="model.Email"
                                       placeholder="Enter email address" />
                            <ValidationMessage For="() => model.Email" />
                        </div>

                        @if (!IsNew)
                        {
                            <div class="status-field">
                                <div>
                                    <strong>Account status</strong>
                                    <span>Active doctors are available for case entry.</span>
                                </div>
                                <label class="status-toggle" for="active">
                                    <InputCheckbox class="form-check-input"
                                                   id="active"
                                                   @bind-Value="model.IsActive" />
                                    <span>Active</span>
                                </label>
                            </div>
                        }
                    </div>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger form-error">@error</div>
                    }
                </div>

                <footer class="form-actions">
                    <a class="btn btn-outline-secondary" href="/doctors">Cancel</a>
                    <button type="submit" class="btn btn-primary" disabled="@saving">
                        @(saving ? "Saving..." : IsNew ? "Add Doctor" : "Save Changes")
                    </button>
                </footer>
            </section>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? DocId { get; set; }

    private bool IsNew => DocId is null;
    private DoctorForm? model;
    private bool saving;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            model = new DoctorForm();
            return;
        }

        var d = await DoctorService.GetByIdAsync(DocId!.Value);

        if (d is null)
        {
            Nav.NavigateTo("/doctors");
            return;
        }

        model = new DoctorForm
        {
            DocName = d.DocName,
            Phone = d.Phone,
            Email = d.Email,
            IsActive = d.IsActive
        };
    }

    private async Task Save()
    {
        saving = true;
        error = null;

        try
        {
            var entity = new Doctor
            {
                DocId = DocId ?? 0,
                DocName = model!.DocName,
                Phone = model.Phone,
                Email = model.Email,
                IsActive = model.IsActive
            };

            if (IsNew)
            {
                await DoctorService.CreateAsync(entity);
            }
            else
            {
                await DoctorService.UpdateAsync(entity);
            }

            Nav.NavigateTo("/doctors");
        }
        catch (DbUpdateException)
        {
            // Violates UQ_Doctors_DocName
            error = "A doctor with that name already exists.";
        }
        finally
        {
            saving = false;
        }
    }

    private class DoctorForm
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(100)]
        public string DocName { get; set; } = string.Empty;

        [StringLength(20)]
        [RegularExpression(@"^[0-9+\-\s]*$", ErrorMessage = "Digits, spaces, + and - only")]
        public string? Phone { get; set; }

        [EmailAddress]
        [StringLength(150)]
        public string? Email { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
