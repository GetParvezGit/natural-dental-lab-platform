@implements IDisposable
@inject NavigationManager NavigationManager

<nav class="site-nav" aria-label="Primary navigation">
    <div class="nav-container">
        <a class="brand" href="/" aria-label="Natural Dental Lab home">
            <span class="brand-mark" aria-hidden="true">N</span>
            <span class="brand-copy">
                <strong>Natural Dental Lab</strong>
                <small>Laboratory Operations</small>
            </span>
        </a>

        <input id="main-nav-toggle"
               class="nav-toggle"
               type="checkbox"
               aria-label="Toggle navigation" />

        <label class="nav-toggle-button"
               for="main-nav-toggle"
               aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <div class="nav-panel">
            <div class="nav-links">
                <AuthorizeView>
                    <NotAuthorized>
                        <NavLink class="nav-link"
                                 href="/"
                                 Match="NavLinkMatch.All">
                            Home
                        </NavLink>
                        <NavLink class="nav-link" href="about">About</NavLink>
                        <NavLink class="nav-link" href="contact">Contact</NavLink>
                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Admin,Staff">
                    <Authorized>
                        <NavLink class="nav-link" href="dashboard">Dashboard</NavLink>
                        <NavLink class="nav-link" href="cases">Cases</NavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Admin">
                    <Authorized>
                        <NavLink class="nav-link" href="doctors">Doctors</NavLink>
                        <NavLink class="nav-link" href="case-types">Case Types</NavLink>
                        <NavLink class="nav-link" href="doctor-rates">Rates</NavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Admin,Staff">
                    <Authorized>
                        <NavLink class="nav-link" href="approval-requests">Requests</NavLink>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Admin">
                    <Authorized>
                        <NavLink class="nav-link" href="users">Users</NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="nav-actions">
                <AuthorizeView>
                    <Authorized Context="authContext">
                        <div class="account-dropdown">
                            <button type="button"
                                    class="account-button"
                                    aria-label="Open account menu">
                                <span class="account-avatar">
                                    @GetInitials(authContext.User.Identity?.Name)
                                </span>
                                <span class="account-copy">
                                    <strong>@DisplayName(authContext.User.Identity?.Name)</strong>
                                    <small>My account</small>
                                </span>
                                <span class="chevron" aria-hidden="true">⌄</span>
                            </button>

                            <div class="account-menu">
                                <NavLink class="account-menu-item"
                                         href="Account/Manage">
                                    Account settings
                                </NavLink>
                                <NavLink class="account-menu-item"
                                         href="Account/Manage/ChangePassword">
                                    Change password
                                </NavLink>

                                <div class="account-divider"></div>

                                <NavLink class="account-menu-item" href="about">
                                    About Natural Dental Lab
                                </NavLink>
                                <NavLink class="account-menu-item" href="contact">
                                    Contact
                                </NavLink>

                                <div class="account-divider"></div>

                                <form action="Account/Logout" method="post">
                                    <AntiforgeryToken />
                                    <input type="hidden"
                                           name="ReturnUrl"
                                           value="/" />
                                    <button type="submit"
                                            class="account-menu-item logout-button">
                                        Sign out
                                    </button>
                                </form>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="login-link" href="Account/Login">Sign in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private string currentUrl = "/";

    protected override void OnInitialized()
    {
        SetCurrentUrl(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs args)
    {
        SetCurrentUrl(args.Location);
        StateHasChanged();
    }

    private void SetCurrentUrl(string absoluteUrl)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(absoluteUrl);

        if (string.IsNullOrWhiteSpace(currentUrl))
        {
            currentUrl = "/";
        }
    }

    private static string DisplayName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Account";
        }

        var atIndex = value.IndexOf('@');
        return atIndex > 0 ? value[..atIndex] : value;
    }

    private static string GetInitials(string? value)
    {
        var parts = DisplayName(value)
            .Split(
                new[] { '.', '_', '-', ' ' },
                StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 0)
        {
            return "ND";
        }

        return string.Concat(
            parts.Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
